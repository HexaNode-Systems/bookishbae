# Frontend uses only public Auth/site values and the backend origin.
# DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_BOOTSTRAP_* and integration
# secrets belong exclusively in backend/.env.local.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CASHFREE_MODE=SANDBOX
BACKEND_URL=http://localhost:5000
