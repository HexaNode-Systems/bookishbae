{
  "name": "bookishbae",
  "version": "0.1.0",
  "private": true,
  "description": "BookishBae — premium e-book store for author Annu.",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run typecheck --workspace=backend",
    "build": "npm run typecheck --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:database": "node backend/tests/run-postgres-tests.mjs",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "db:seed-admin": "npm run db:seed-admin --workspace=backend"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "autoprefixer": "^10.4.20",
    "cashfree-pg": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@napi-rs/canvas": "^0.1.65",
    "@types/node": "^20.17.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
