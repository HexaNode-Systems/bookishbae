#
# BookishBae — environment template
#
# Copy to .env.local for development, and paste the same keys into Vercel's
# project settings for production.
#
#   cp .env.example .env.local
#
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle. Everything
# else is server-only and must never acquire that prefix. If you are unsure
# which a value is, ask whether you would paste it into a public GitHub issue.
#
# A missing or malformed value fails fast at startup with a message naming the
# variable — see src/lib/env.ts.
#

# =============================================================================
# Site
# =============================================================================

# Canonical origin, no trailing slash. Used for canonical tags, OG images,
# email links, the CORS allowlist and Cashfree return URLs.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://bookishbae.com

# Node API origin used by the frontend /api rewrite. Production must use HTTPS.
BACKEND_URL=http://localhost:5000

# Explicit backend mode. Set to production in the production runtime.
NODE_ENV=development


# =============================================================================
# Supabase  —  Project settings > API
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# The anon key is designed to be public. It is only safe because RLS is on for
# every table; do not disable RLS "just to debug something".
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SECRET. Bypasses every RLS policy. Server-side only — route handlers, server
# actions and scripts. If this ever reaches a browser, rotate it immediately
# from Project settings > API > Reset service role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# =============================================================================
# Cloudinary  —  Dashboard > API Keys
# =============================================================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# =============================================================================
# Cashfree  —  Merchant Dashboard > Developers > API Keys
# =============================================================================

# App ID (starts with TEST for sandbox)
CASHFREE_APP_ID=TESTxxxxxxxxxxxx

# SECRET. Never expose.
CASHFREE_SECRET_KEY=

# Environment: TEST or PRODUCTION
CASHFREE_ENVIRONMENT=TEST

# Client environment: SANDBOX or PRODUCTION
NEXT_PUBLIC_CASHFREE_MODE=SANDBOX


# =============================================================================
# Brevo  —  app.brevo.com > SMTP & API > API Keys
# =============================================================================

BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# Must be a verified sender in Brevo.
EMAIL_FROM="BookishBae <hello@bookishbae.com>"

# Optional. Where replies to transactional email should go.
EMAIL_REPLY_TO=hello@bookishbae.com


# =============================================================================
# Operations
# =============================================================================

# Direct PostgreSQL - BACKEND ONLY. Get the URI from Supabase Connect.
# Never put these variables in frontend/.env.local or prefix them NEXT_PUBLIC_.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=10
# Optional PEM CA certificate; literal \n sequences are supported.
DATABASE_SSL_CA=

# Admin bootstrap - BACKEND ONLY. Supply privately; do not commit actual values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Existing passwords are preserved unless explicitly enabled for this seed run.
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# Lifetime of a presigned download URL, in seconds. Clamped to 30-300.
# Long enough for a slow mobile connection to begin the transfer; short enough
# that a link pasted into a group chat is already dead.
DOWNLOAD_URL_TTL_SECONDS=90

# Lifetime of a presigned admin upload URL, in seconds. Clamped to 60-3600.
# A 100 MB PDF on a slow connection needs more than a couple of minutes.
UPLOAD_URL_TTL_SECONDS=600

# Downloads allowed per purchase before the buyer has to ask. Per-product and
# per-order-item overrides both exist; this is only the default.
DOWNLOAD_LIMIT_DEFAULT=5

# Hard ceiling for watermarking, in bytes. Above this the original is served
# unmodified, because watermarking loads the whole PDF into a serverless
# function's heap. Default 20 MB. See docs/DECISIONS.md #2.
WATERMARK_MAX_BYTES=20971520

# Set to false only to debug locally. Never in production.
RATE_LIMIT_ENABLED=true

# SECRET. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Salts the hash of client IPs in audit logs, so the log is useful for spotting
# abuse without storing addresses. Changing it makes old rows uncomparable.
IP_HASH_SALT=


# =============================================================================
# Build
# =============================================================================

# Set to true ONLY in a CI build that has no secrets and only needs to compile.
# It skips env validation entirely, so never set it on a running deployment.
# SKIP_ENV_VALIDATION=false
